<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#f7f6f2" />
  <title>Studio Yoan</title>

  <style>
    :root {
      --page-max: 760px;
      --side: clamp(22px, 7vw, 54px);
      --glass-bg: rgba(255, 255, 255, 0.18);
      --glass-border: rgba(255, 255, 255, 0.62);
      --glass-border-dark: rgba(0, 0, 0, 0.08);
      --text: rgba(12, 12, 12, 0.92);
    }

    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    html, body {
      margin: 0;
      min-height: 100%;
      background: #f7f6f2;
      color: var(--text);
      font-family:
        -apple-system, BlinkMacSystemFont,
        "Apple SD Gothic Neo", "Pretendard",
        "Noto Sans KR", "Helvetica Neue", Arial, sans-serif;
    }

    body {
      min-height: 100svh;
      display: flex;
      justify-content: center;
    }

    .page {
      position: relative;
      width: min(100%, var(--page-max));
      min-height: 100svh;
      overflow: hidden;
      isolation: isolate;
      background: #f7f6f2;
    }

    /* Background image */
    .page::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: -3;
      width: min(100%, var(--page-max));
      margin-inline: auto;
      background:
        linear-gradient(
          to bottom,
          rgba(255,255,255,0.06),
          rgba(255,255,255,0.02)
        ),
        url("bg.jpg") center top / cover no-repeat;
    }

    /* Very subtle milk-glass veil */
    .page::after {
      content: "";
      position: fixed;
      inset: 0;
      z-index: -2;
      width: min(100%, var(--page-max));
      margin-inline: auto;
      pointer-events: none;
      background: rgba(255, 255, 255, 0.02);
    }

    main {
      min-height: 100svh;
      padding:
        max(58px, env(safe-area-inset-top))
        var(--side)
        max(42px, env(safe-area-inset-bottom));
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .brand {
      margin: 0 0 clamp(46px, 7vh, 72px);
    }

    .brand img {
      display: block;
      width: min(74%, 460px);
      max-height: 118px;
      object-fit: contain;
      object-position: left center;
      filter: none;
    }

    .links {
      display: grid;
      gap: 14px;
    }

    .glass-button {
      position: relative;
      display: grid;
      place-items: center;
      min-height: 78px;
      padding: 18px 24px;
      border-radius: 24px;

      color: var(--text);
      text-decoration: none;
      text-align: center;
      font-size: clamp(17px, 4.3vw, 22px);
      font-weight: 400;
      letter-spacing: -0.025em;

      /* iOS-style liquid glass base */
      background:
        linear-gradient(
          135deg,
          rgba(255,255,255,0.34) 0%,
          rgba(255,255,255,0.13) 44%,
          rgba(255,255,255,0.22) 100%
        );
      border: 1px solid var(--glass-border);
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.78),
        inset 0 -1px 0 rgba(255,255,255,0.15),
        0 8px 22px rgba(20, 20, 20, 0.055),
        0 1px 2px rgba(20, 20, 20, 0.035);

      -webkit-backdrop-filter: blur(18px) saturate(145%);
      backdrop-filter: blur(18px) saturate(145%);
      overflow: hidden;
      transform: translateZ(0);
      transition:
        transform 160ms ease,
        background 160ms ease,
        box-shadow 160ms ease;
    }

    /* Fine dark edge: gives the glass shape definition on white areas */
    .glass-button::before {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: inherit;
      box-shadow: inset 0 0 0 0.5px var(--glass-border-dark);
      pointer-events: none;
    }

    /* Soft specular highlight */
    .glass-button::after {
      content: "";
      position: absolute;
      width: 72%;
      height: 180%;
      top: -122%;
      left: -14%;
      border-radius: 50%;
      background: radial-gradient(
        ellipse at center,
        rgba(255,255,255,0.38) 0%,
        rgba(255,255,255,0.12) 38%,
        rgba(255,255,255,0) 72%
      );
      transform: rotate(-8deg);
      pointer-events: none;
    }

    .glass-button span {
      position: relative;
      z-index: 1;
    }

    .glass-button:active {
      transform: scale(0.985);
      background:
        linear-gradient(
          135deg,
          rgba(255,255,255,0.42),
          rgba(255,255,255,0.18)
        );
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.82),
        0 4px 12px rgba(20,20,20,0.04);
    }

    @media (hover: hover) and (pointer: fine) {
      .glass-button:hover {
        transform: translateY(-1px);
        background:
          linear-gradient(
            135deg,
            rgba(255,255,255,0.42) 0%,
            rgba(255,255,255,0.16) 50%,
            rgba(255,255,255,0.25) 100%
          );
        box-shadow:
          inset 0 1px 0 rgba(255,255,255,0.86),
          0 12px 28px rgba(20,20,20,0.065);
      }
    }

    @supports not ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) {
      .glass-button {
        background: rgba(255, 255, 255, 0.72);
      }
    }

    @media (max-height: 760px) {
      main {
        justify-content: flex-start;
        padding-top: max(40px, env(safe-area-inset-top));
      }

      .brand {
        margin-bottom: 32px;
      }

      .glass-button {
        min-height: 68px;
      }

      .links {
        gap: 11px;
      }
    }
  </style>
</head>

<body>
  <div class="page">
